# Copy this file to fastlane/.env and fill in the secret values.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=/Users/your-name/.keys/AuthKey_KEY_ID.p8

MATCH_GIT_URL=https://github.com/Yarn-Digi/fastlane-match.git
MATCH_PASSWORD=

# Only needed by Apple ID-based fallback flows.
FASTLANE_APPLE_ID=
ITC_TEAM_ID=
